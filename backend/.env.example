# ==============================================================================
# ZAITOON PAKISTAN BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/zaitoon_pakistan

# Client URLs & CORS (supports React storefront & Admin panel)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:3000
SUB_CLIENT_URL=
SERVER_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & JWT Authentication
JWT_SECRET=zaitoon-pakistan-super-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session

# Seed / Initial Admin Bootstrap (Used by seed script & initial bootstrap)
ADMIN_NAME=Zaitoon Administrator
ADMIN_EMAIL=admin@zaitoonpakistan.pk
ADMIN_PASSWORD=ZaitoonAdmin2026!

# Media Storage (Cloudinary - optional; local /uploads fallback is automatic)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_PRODUCT_FOLDER=zaitoon/products

# Request limits
REQUEST_BODY_LIMIT=10mb
MAX_UPLOAD_FILE_SIZE_MB=25

# Production Hardening (uncomment in production)
# TRUST_PROXY=true
# LOG_FORMAT=json
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.zaitoonpakistan.pk
